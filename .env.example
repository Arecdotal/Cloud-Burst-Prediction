# Copy to .env and edit. Everything has a sensible default except ADMIN_API_KEY.

# Protects POST /predictions/run, GET /features/preview, PUT /outcomes/*.
# Leave empty to disable admin endpoints. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Location and day definition (verify against how the training data was built)
LOCATION_NAME=Dehradun
LATITUDE=30.3165
LONGITUDE=78.0322
WEATHER_TIMEZONE=Asia/Kolkata
# OPENMETEO_MODELS=            # optional, e.g. era5 for archive backtests

# Scheduler: cron hours in WEATHER_TIMEZONE
ENABLE_SCHEDULER=true
SCHEDULE_HOURS=2,8,14,20
SCHEDULE_MINUTE=10
RUN_ON_STARTUP=true

# Frontend origins allowed by CORS (comma separated). Set your real domain in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Slack / Discord / custom webhook for alerts
ALERT_WEBHOOK_URL=

# Safety limits
MAX_MISSING_FRACTION=0.25
STALE_AFTER_HOURS=12
# ALLOW_SKLEARN_MISMATCH=false  # leave false; true lets the app start on a wrong scikit-learn
